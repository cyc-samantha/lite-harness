# Local-only run/scratch state under .claude/ — never committed to this repo.
# (Line-ending normalization is handled by .gitattributes, not here.)
.claude/worktrees/
.claude/agent-memory/
.claude/pipeline-state/
.claude/session-memory/
# Session-id+pid lock files (e.g. scheduled_tasks.lock convention) — never
# committed by accident.
/.claude/*.lock

# Node toolchain
node_modules/

# Per-run engine state (never committed)
run/
