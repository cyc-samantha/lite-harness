# Local-only run/scratch state under .claude/ — never committed to this repo.
# (Line-ending normalization is handled by .gitattributes, not here.)
.claude/worktrees/
.claude/agent-memory/
.claude/pipeline-state/
.claude/session-memory/
# Session-id+pid lock files (e.g. scheduled_tasks.lock convention) — never
# committed by accident.
/.claude/*.lock

# Node toolchain
node_modules/

# Per-run engine state (never committed).
# Anchored to the repository root: unanchored, `run/` matches a directory of that
# name at any depth, which silently swallowed skills/run/ — the plugin's only
# entry point — for the whole of its existence.
/run/
