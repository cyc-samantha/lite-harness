{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "-lc",
              "h=\"${CLAUDE_PLUGIN_ROOT:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}/hooks/main-branch-guard.sh\"; [ -x \"$h\" ] && exec \"$h\" || exit 0"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "-lc",
              "h=\"${CLAUDE_PLUGIN_ROOT:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}/hooks/worktree-boundary.sh\"; [ -x \"$h\" ] && exec \"$h\" || exit 0"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash",
            "args": [
              "-lc",
              "h=\"${CLAUDE_PLUGIN_ROOT:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}/hooks/secret-guard.sh\"; [ -x \"$h\" ] && exec \"$h\" || exit 0"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "-lc",
              "h=\"${CLAUDE_PLUGIN_ROOT:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}/hooks/audit-logger.sh\"; [ -x \"$h\" ] && exec \"$h\" || exit 0"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
